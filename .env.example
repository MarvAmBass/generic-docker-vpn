# Copy to .env and fill in. Values here feed compose.yml.

# Your VPN provider's WireGuard endpoint (numeric IP; must match the
# Endpoint line in config/wg0.conf). The kill switch only permits
# encrypted UDP to exactly this address.
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=51820

# Kill switch: on (default) or off. "off" keeps tunnel-only routing but
# removes the firewall enforcement — debugging only, loudly warned.
KILLSWITCH=on

# DNS used inside the namespace, resolved through the tunnel.
VPN_DNS=1.1.1.1

# SearXNG secret key. Generate once:  openssl rand -hex 32
SEARXNG_SECRET=

# Where the LAN gateway publishes the SearXNG UI.
# 127.0.0.1 = this machine only. Set a LAN IP to share (add auth first!).
LAN_BIND_IP=127.0.0.1
SEARXNG_LAN_PORT=8080
# If you bind to a LAN IP, set this to the URL you browse to:
SEARXNG_BASE_URL=http://127.0.0.1:8080/

# URL the healthcheck fetches through (and must NOT fetch around) the tunnel.
#HEALTHCHECK_URL=https://1.1.1.1
