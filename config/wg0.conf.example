# Put the WireGuard config you download from your VPN provider at
# config/wg0.conf — this file only shows the expected shape (most providers
# offer a "WireGuard config" export that looks exactly like this).
#
# Notes:
# - The gateway strips wg-quick-only keys (Address/DNS/MTU/Table/PostUp/
#   PostDown are parsed or ignored by the entrypoint) — routing, DNS, and
#   firewalling are managed by the gateway itself, so a stock provider
#   config works unmodified.
# - Prefer a numeric Endpoint IP, and mirror it in VPN_ENDPOINT_IP /
#   VPN_ENDPOINT_PORT: the kill switch only permits encrypted UDP to that
#   exact address, and no DNS lookup is needed during startup.

[Interface]
PrivateKey = REPLACE_WITH_YOUR_PRIVATE_KEY
Address = 10.64.0.2/32
DNS = 10.64.0.1
MTU = 1420

[Peer]
PublicKey = REPLACE_WITH_PROVIDER_PUBLIC_KEY
AllowedIPs = 0.0.0.0/0
Endpoint = REPLACE_WITH_ENDPOINT_IP:51820
PersistentKeepalive = 25
